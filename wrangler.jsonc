
{
  "name": "c-b",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "keep_vars": true,
  "build": {
    "command": "node build-static.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/beheer",
      "/beheer/*",
      "/admin.html",
      "/beheer.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cb-banden-db",
      "database_id": "c83e25dd-903a-4d54-8b08-da13ba0afd1d"
    }
  ]
}
